{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend - FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "Frontend - Vite",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Ejecutar Todo (Backend + Frontend)",
            "configurations": ["Backend - FastAPI", "Frontend - Vite"],
            "stopAll": true
        }
    ]
}
